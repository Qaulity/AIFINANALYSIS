# Application settings
APP_NAME=Financial News Analysis
DEBUG=true

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# API Keys
NEWSAPI_KEY=your_newsapi_key_here
ALPHAVANTAGE_KEY=your_alphavantage_key_here

# NLP Settings
# Sentiment model: finbert (accurate, uses deep learning) or textblob (fast, lightweight)
SENTIMENT_MODEL=finbert

# Enable BERTopic for topic modeling and clustering
ENABLE_TOPIC_MODELING=true

# Use GPU for ML models (auto-detects if CUDA available)
USE_GPU=true

# Batch size for NLP processing
NLP_BATCH_SIZE=16
